{# Params: safe_name, layer_name, n_channels, input_buf, output_buf #}
/* Middle-plate: BN + requantize (no ReLU) -- {{ layer_name }} */
{
    int _ch;
    for (_ch = 0; _ch < {{ n_channels }}; _ch++) {
        float _v = (float){{ input_buf }}[_ch] * {{ safe_name }}_bn_scale[_ch]
                   + {{ safe_name }}_bn_bias[_ch];
        int32_t _q = (int32_t)(_v + (_v >= 0.0f ? 0.5f : -0.5f));
        if (_q >  127) _q =  127;
        if (_q < -128) _q = -128;
        {{ output_buf }}[_ch] = (int8_t)_q;
    }
}
